---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { getCollection } from 'astro:content';
import { blocks } from '../data/categories.js';
const all = await getCollection('articulos', ({data}) => import.meta.env.PROD ? data.draft !== true : true);
const posts = all.filter(p => !p.data.draft).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const schema={"@context":"https://schema.org","@type":"WebSite","name":"Eficasa","url":Astro.site?.toString()??Astro.url.origin,"description":"Energía solar y ahorro energético en el hogar.","publisher":{"@type":"Organization","name":"Eficasa","email":"sergiopalling@gmail.com"}};
---
<BaseLayout title="Eficasa | Energía solar y ahorro energético" description="Guías claras para ahorrar en la factura de la luz, entender tu consumo y valorar placas solares, aerotermia y otras soluciones.">
<JsonLd data={schema}/>
<section class="hero"><div class="container"><span class="eyebrow">Energía en casa, explicada fácil</span><h1>Entiende tu energía. <span style="color:var(--teal)">Ahorra mejor.</span></h1><p>Guías prácticas para entender la factura de la luz, reducir gastos y tomar decisiones informadas sobre placas solares, aerotermia y eficiencia energética.</p><div class="hero-actions"><a class="btn btn-primary" href="/eficasa/guias">Leer guías publicadas</a><a class="btn btn-secondary" href="/eficasa/herramientas">Probar calculadoras</a></div></div></section>
<section class="section"><div class="container"><div class="section-header"><div><h2>Todo empieza por entender lo que pagas</h2><p class="section-intro">Cinco bloques para encontrar rápidamente la información que buscas, sin tecnicismos innecesarios.</p></div></div><div id="bloques" class="grid grid-5">{blocks.map(block=><a class="card" href={block.url}><div class="icon">{block.icon}</div><span class="badge">Bloque {block.key}</span><h3>{block.name}</h3><p>{block.desc}</p></a>)}</div></div></section>
<section class="section" style="padding-top:20px"><div class="container"><div class="section-header"><div><h2>Artículos más destacados de cada bloque</h2><p class="section-intro">Un buen punto de partida en cada tema.</p></div></div><div class="grid">{['guia-autoconsumo-solar-espana','ayudas-y-subvenciones-placas-solares','como-leer-la-factura-de-la-luz','aerotermia-que-es-cuanto-cuesta','kit-solar-de-balcon'].map(slug=>{const p=posts.find(item=>item.data.slug===slug);return p?<article class="card article-card"><span class="badge">{p.data.category}</span><h3>{p.data.title}</h3><p>{p.data.description}</p><a class="read" href={`/articulos/${p.data.slug}`}>Leer artículo →</a></article>:null})}</div><p style="margin-top:24px"><a href="/eficasa/guias">Ver todas las guías →</a></p></div></section>
<section class="section"><div class="container"><div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap"><div><span class="eyebrow">Herramientas</span><h2 style="margin-top:12px">Haz números antes de tomar una decisión</h2><p class="section-intro">Calculadoras sencillas para potencia, consumo y ahorro solar. Funcionan en tu navegador y no envían tus datos a ningún servidor.</p></div><a class="btn btn-primary" href="/eficasa/herramientas">Ver herramientas</a></div></div></section>
</BaseLayout>
